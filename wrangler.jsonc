
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "konnectionsimag",
  "compatibility_date": "2026-01-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Limits contact-form submissions per visitor IP (src/lib/contactGuard.ts).
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}