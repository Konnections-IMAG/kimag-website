# Copy to .env.local for local development. Never commit real values.
# On Cloudflare, add secrets with `npx wrangler secret put NAME`.

# Gmail account that sends contact-form mail, and its app password
MAIL_USER=
MAIL_PASS=

# Optional: inbox that receives enquiries (defaults to MAIL_USER)
ADMIN_EMAIL=

# Optional: site URL used in confirmation emails
BASE_URL=https://www.konnectionsimag.com

# Optional bot protection (Cloudflare Turnstile). Set both or neither.
# The site key is baked in at BUILD time, so it must be set as a build variable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
